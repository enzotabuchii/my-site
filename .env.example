# Variáveis de ambiente para o tracker de acessos
# Copie para .env.local em desenvolvimento e configure na Vercel (Settings → Environment Variables)

# Token para proteger a página /acessos e a API de leitura/exclusão
# Gere algo aleatório e seguro, ex.: openssl rand -hex 32
ACESSOS_TOKEN=""

# Upstash Redis (o que a Vercel usa agora) — persiste os logs em produção
# Crie um Redis na Vercel (Storage → Create Database → Redis/Upstash) e cole as duas variáveis abaixo.
# Em dev local, sem essas vars, o fallback é data/acessos.json no disco.
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# Aliases antigos (ainda funcionam se você já tinha KV configurado)
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""